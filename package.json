{
  "name": "n8n-nodes-finn",
  "version": "0.1.2",
  "description": "n8n community nodes for finn (hirefinn.ai): contacts, notes, Operator agents and instant webhook triggers through Finn's public API v1.",
  "keywords": [
    "n8n-community-node-package",
    "finn",
    "hirefinn",
    "crm",
    "ai-employees"
  ],
  "license": "MIT",
  "homepage": "https://hirefinn.ai",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/dev3935/n8n-nodes-finn.git"
  },
  "bugs": {
    "url": "https://gitlab.com/dev3935/n8n-nodes-finn/-/issues"
  },
  "author": {
    "name": "finn",
    "email": "support@hirefinn.ai"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FinnApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Finn/Finn.node.js",
      "dist/nodes/FinnTrigger/FinnTrigger.node.js"
    ]
  },
  "engines": {
    "node": ">=20.15"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.3",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.4",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.8.3",
    "release-it": "^20.2.0",
    "typescript": "^5.6.0"
  }
}
